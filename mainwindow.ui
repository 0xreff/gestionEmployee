   <string notr="true">font: 600 12pt &quot;Segoe UI&quot;;
QPushButton {
    background-color: #4CAF50; /* Vert pour les boutons */
    color: white;
    border: none;
    padding: 10px 20px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 16px;
    margin: 4px 2px;
    cursor: pointer;
}

QPushButton:hover {
    background-color: #45a049;
}
</string>
