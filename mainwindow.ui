    <property name="styleSheet">
     <string notr="true">/* Style pour la barre de navigation (QNavBar) */
QGraphicsView {
    background-color: #003366; /* Bleu roi */
    padding: 10px;
    border-bottom: 2px solid #001f3f; /* Bordure plus foncée */
}

/* Style pour les boutons dans la barre de navigation */
QGraphicsView QPushButton {
    background-color: #00509e; /* Bleu plus clair */
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 5px; /* Coins arrondis */
    transition: background-color 0.3s ease, transform 0.2s ease; /* Animation */
}

/* Effet au survol des boutons */
QGraphicsView QPushButton:hover {
    background-color: #0077cc; /* Bleu plus vif au survol */
    transform: scale(1.05); /* Légère augmentation de taille */
}

/* Effet au clic des boutons */
QGraphicsView QPushButton:pressed {
    background-color: #001f3f; /* Bleu plus foncé au clic */
    transform: scale(0.95); /* Légère réduction de taille */
}

/* Style pour les boutons actifs (optionnel) */
QGraphicsView QPushButton:checked {
    background-color: #001f3f; /* Bleu foncé pour le bouton actif */
    border: 2px solid #00509e; /* Bordure pour le bouton actif */
}</string>
    </property>
   </widget>
